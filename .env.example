# Where the browser sends API calls.
#  - Deployed console (origin allowed by the backend's CORS list): the API itself.
#  - Local dev: leave EMPTY and set API_PROXY_TARGET below, so calls go through
#    this app's own /api/v1 proxy (vex-dev's admin CORS only allows vxa.vercel.app).
NEXT_PUBLIC_API_BASE_URL=https://vex-dev.up.railway.app

# Local dev only: the API that /api/v1/* is proxied to (see next.config.ts).
# API_PROXY_TARGET=https://vex-dev.up.railway.app
