// Vexora Admin (VXA) — Prisma schema
//
// Models the admin domain per caveman/docs/05-Database.md. SQLite doesn't
// support native enums (Prisma will reject an `enum` block on this
// connector), so enum-shaped fields are plain String columns — the allowed
// values are documented above each field instead. Mirrors VXP's own
// Prisma+SQLite stub setup; these models aren't wired to live queries yet
// (see src/lib/admin-data.ts for the mock data the UI actually reads today).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Separate admin identity table — admin access is never a role flag on a
/// consumer `User` row (04-System-Architecture.md §14.2).
model AdminUser {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  /// "super_admin" | "ops" | "finance" | "moderator" — VXA currently seeds and
  /// supports only "super_admin" (see caveman/docs/16-Decisions.md ADR-031).
  role             String    @default("super_admin")
  totpSecret       String?
  totpConfirmedAt  DateTime?
  /// JSON array of hashed recovery codes
  recoveryCodes    String?
  isActive         Boolean   @default(true)
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())

  auditLogs        AdminAuditLog[]
  platformConfigs  PlatformConfig[]
}

/// Append-only mutation trail — every admin write lands one row here in the
/// same transaction (NFR-08). No `updatedAt`: rows are immutable.
model AdminAuditLog {
  id          Int       @id @default(autoincrement())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id])
  /// e.g. "listing.approve", "config.update", "payment.manual_activate"
  action      String
  entityType  String
  entityId    String
  /// JSON state diff
  before      String?
  after       String?
  ip          String?
  requestId   String?
  createdAt   DateTime  @default(now())

  @@index([adminUserId, createdAt])
  @@index([entityType, entityId])
}

/// Typed key/value platform config (G8) — Redis-cached in the real system;
/// writes bust `config:{key}` and version membership plans separately.
model PlatformConfig {
  key         String    @id
  /// JSON-encoded value, typed by `type`
  value       String
  /// "int" | "decimal" | "string" | "boolean" | "json"
  type        String
  description String?
  updatedById String?
  updatedBy   AdminUser? @relation(fields: [updatedById], references: [id])
  updatedAt   DateTime  @updatedAt
}

/// Consumer identity — intentionally minimal; VXP owns the real user domain,
/// this is just enough shape for the admin queues to reference by id.
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  /// "Free" | "Mercury" | "Jupiter" | "Venus"
  tier      String   @default("Free")
  /// "Active" | "Suspended" | "Pending"
  status    String   @default("Active")
  createdAt DateTime @default(now())

  listings       Listing[]
  kycSubmissions KycSubmission[]
  memberships    MembershipOrder[]
  payments       Payment[]
}

/// Listing moderation queue (G4).
model Listing {
  id           String    @id @default(cuid())
  title        String
  location     String
  ownerId      String
  owner        User      @relation(fields: [ownerId], references: [id])
  /// "pending_review" | "live" | "rejected" | "removed"
  status       String    @default("pending_review")
  rejectionReason String?
  validityDays Int       @default(30)
  submittedAt  DateTime  @default(now())
  expiresAt    DateTime?
}

/// KYC document review + badge grants (G5).
model KycSubmission {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  /// "PAN" | "Aadhaar" | "RERA Certificate" | "GST Certificate"
  docType     String
  /// "pending" | "approved" | "rejected"
  status      String    @default("pending")
  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?
}

model Badge {
  id          String   @id @default(cuid())
  entityLabel String
  /// "Jupiter Verified" | "Featured Developer"
  badgeType   String
  /// "pending" | "granted" | "revoked"
  status      String   @default("pending")
  grantedAt   DateTime?
}

/// Ad creative approval queue (G6).
model Ad {
  id              String   @id @default(cuid())
  headline        String
  advertiser      String
  /// "Homepage Hero" | "Search Spotlight" | "Featured Developer"
  slot            String
  amountInr       Int
  /// "Paid" | "Pending"
  paymentStatus   String   @default("Pending")
  /// "Under Review" | "Approved" | "Rejected"
  approvalStatus  String   @default("Under Review")
  rejectionReason String?
  submittedAt     DateTime @default(now())
}

/// Notification template editor (G7) — versioned per event × channel.
model NotificationTemplate {
  id          String   @id @default(cuid())
  eventKey    String
  eventLabel  String
  /// "email" | "sms" | "whatsapp" | "push"
  channel     String
  version     Int      @default(1)
  body        String
  updatedAt   DateTime @updatedAt

  @@unique([eventKey, channel, version])
}

/// Versioned membership plans (G8) — price changes create a new version row.
model MembershipPlan {
  id                 String   @id @default(cuid())
  /// "Free" | "Mercury" | "Jupiter" | "Venus"
  tier               String
  version            Int      @default(1)
  priceInr           Int
  billingCycleMonths Int
  effectiveFrom      DateTime @default(now())
  isCurrent          Boolean  @default(true)

  @@unique([tier, version])
}

/// Stuck/failed membership orders needing manual activation (G3).
model MembershipOrder {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  plan        String
  amountInr   Int
  razorpayRef String
  /// "processing" | "failed" | "activated"
  status      String    @default("processing")
  createdAt   DateTime  @default(now())
  activatedAt DateTime?
}

/// Payment log + manual-only refund notes (G10) — no automated refund engine.
model Payment {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  purpose     String
  amountInr   Int
  razorpayRef String
  /// "captured" | "refunded" | "failed"
  status      String   @default("captured")
  refundNote  String?
  createdAt   DateTime @default(now())
}

/// Abuse report queue (G9) — 48h SLA, transactional resolution.
model AbuseReport {
  id          String    @id @default(cuid())
  /// "listing" | "user" | "ad"
  entityType  String
  entityLabel String
  reason      String
  reportedBy  String
  reportedAt  DateTime  @default(now())
  slaDueAt    DateTime
  /// "open" | "resolved"
  status      String    @default("open")
  /// "none" | "warning" | "hide" | "remove" | "suspend"
  resolution  String?
  resolvedAt  DateTime?
}
